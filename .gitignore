# Sorties de packaging
dist/

# Espaces de travail isolés créés par l'outil Agent (isolation: "worktree")
# pour l'exécution de sous-agents — infrastructure de session, pas du
# contenu du dépôt ; auto-nettoyés en fin d'agent.
.claude/

# Python
__pycache__/
*.py[cod]

# Archives locales du dépôt : `package_skill.py` et les sauvegardes manuelles
# produisent des archives à la racine. Les versionner reviendrait à empaqueter
# le dépôt dans lui-même à chaque `git add -A`.
*.7z
*.zip
*.tar.gz
